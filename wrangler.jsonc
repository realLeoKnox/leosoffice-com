// Cloudflare Workers static-assets deployment for www.leosoffice.com.
// Workers Builds runs `npx wrangler deploy`: build.command renders the pages,
// Vite bundles React + react-three-fiber + Three.js; ONLY ./dist is published.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leosoffice-com",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm ci --no-audit --no-fund && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
